                </div>

                <div v-if="gameState === 'playing'" class="round-badge">
                    <span class="round-text">{{ lang === 'zh' ? '第' : 'Round ' }}{{ currentRound }}/{{ maxRounds }}</span>
                    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                        <span style="opacity:0.4;font-size:0.8rem;">14个选项</span>
                        <button class="btn btn-danger" @click="exitGame" style="padding:6px 16px;font-size:0.8rem;"><i class="fas fa-sign-out-alt"></i> 退出</button>
                    </div>
                </div>

                <div v-if="roundReport && gameState === 'playing'" class="round-report"><div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;"><span><strong>{{ roundReport.cardName[lang] }}</strong> <span :style="{color: roundReport.totalChange >= 0 ? '#6fcf97' : '#f28b82', fontWeight:700}">{{ roundReport.totalChange >= 0 ? '+' : '' }}{{ Math.floor(roundReport.totalChange) }}</span></span><span style="opacity:0.6;">🤼 小明 {{ roundReport.rivalChange >= 0 ? '+' : '' }}{{ Math.floor(roundReport.rivalChange) }} → {{ Math.floor(roundReport.rivalTotal) }}</span></div></div>

                <div v-if="gameState === 'landing'" class="card" style="text-align:center;padding:50px 20px;">
                    <h1 style="font-size:3.2rem;color:#e6c27a;">Wealth Builder AI</h1>
                    <h2 style="font-weight:300;color:#b8943c;">财富成长实验室</h2>
                    <p style="font-size:1.1rem;margin:20px 0;opacity:0.8;">10轮真实财经事件 · 14种投资选项 · 自己判断</p>
                    <div style="margin:20px 0;">
                        <p style="opacity:0.6;font-size:0.9rem;margin-bottom:10px;">🤼 选择小明的投资风格</p>
                        <div class="style-select">
                            <div v-for="style in rivalStyles" :key="style.id" class="style-option" :class="{active: selectedRivalStyle === style.id}" @click="selectedRivalStyle = style.id; resetRival();">
