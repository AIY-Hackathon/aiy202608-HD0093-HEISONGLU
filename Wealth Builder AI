                            usedEventIds.value = []; 
                            const ev = eventDB[Math.floor(Math.random() * eventDB.length)]; 
                            pendingEvent = ev; 
                        } else {
                            const ev = available[Math.floor(Math.random() * available.length)];
                            pendingEvent = ev;
                        }
                        if (eventTriggerTimer) clearTimeout(eventTriggerTimer);
                        eventTriggerTimer = setTimeout(() => {
                            doTriggerEvent(pendingEvent);
                            pendingEvent = null;
                            eventTriggerTimer = null;
                        }, 2800); // 等反馈动画结束（2.5s + 缓冲）
                        return;
                    }
                    // 直接触发
                    const available = eventDB.filter(e => !usedEventIds.value.includes(e.id));
                    if (available.length === 0) { 
                        usedEventIds.value = []; 
                        const ev = eventDB[Math.floor(Math.random() * eventDB.length)]; 
                        doTriggerEvent(ev); 
                        return; 
                    }
                    const ev = available[Math.floor(Math.random() * available.length)];
                    doTriggerEvent(ev);
                }

                function doTriggerEvent(ev) {
                    if (!ev) return;
                    currentEvent.value = ev; 
                    usedEventIds.value.push(ev.id); 
                    showEvent.value = true; 
                    eventLog.value.push({ event: ev, round: round.value });
                }

                function closeEventManual() { showEvent.value = false; }
                function viewEventDetail(logItem) { currentEvent.value = logItem.event; showEvent.value = true; }

                // ---- 选择卡片（反馈锁定期间不可操作） ----
                function selectCard(cardId) {
                    if (isGameOver.value || showEvent.value || showResult.value || isFeedbackShowing.value) return;
                    const card = allCards.find(c => c.id === cardId);
                    if (!card) return;
                    snapshot.value = { ...resources.value };
                    if (card.cost.cash && resources.value.cash < card.cost.cash) { aiFeedback.value = lang.value === 'zh' ? '现金不足。你觉得借钱投资划算吗？' : 'Insufficient cash.'; return; }
                    if (card.cost.knowledge && resources.value.knowledge < card.cost.knowledge) { aiFeedback.value = lang.value === 'zh' ? '知识不足。你确定自己真的看懂了这个投资吗？' : 'Low knowledge.'; return; }
                    if (card.cost.network && resources.value.network < card.cost.network) { aiFeedback.value = lang.value === 'zh' ? '人脉不足。你觉得靠自己能搞定吗？' : 'Network insufficient.'; return; }
                    const costCash = card.cost.cash || 0, costKnowledge = card.cost.knowledge || 0, costNetwork = card.cost.network || 0;
                    if (costCash) resources.value.cash -= costCash;
                    if (costKnowledge) resources.value.knowledge -= costKnowledge;
                    if (costNetwork) resources.value.network -= costNetwork;
                    let rewardCash = card.reward.cash || 0, rewardKnowledge = card.reward.knowledge || 0, rewardReputation = card.reward.reputation || 0, rewardNetwork = card.reward.network || 0;
                    const ev = currentEvent.value;
                    let eventName = null;
                    if (ev) {
                        eventName = ev.title;
                        const impact = ev.impact;
                        rewardCash = Math.floor(rewardCash * (impact.cash || 1));
                        rewardKnowledge = Math.floor(rewardKnowledge * (impact.knowledge || 1));
                        rewardReputation = Math.floor(rewardReputation * (impact.reputation || 1));
                        rewardNetwork = Math.floor(rewardNetwork * (impact.network || 1));
                        if (ev.bonuses && ev.bonuses[card.id]) { const bonus = ev.bonuses[card.id]; rewardCash = Math.floor(rewardCash * bonus); rewardReputation = Math.floor(rewardReputation * Math.min(bonus, 1.5)); }
                        if (resources.value.knowledge >= 60) rewardCash = Math.floor(rewardCash * 1.1);
                        if (card.id === 'ai' && resources.value.knowledge >= 80) rewardCash = Math.floor(rewardCash * 1.3);
                        if (card.id === 'crypto' && resources.value.knowledge >= 70) rewardCash = Math.floor(rewardCash * 1.4);
                    }
                    resources.value.cash += rewardCash; resources.value.knowledge += rewardKnowledge;
                    resources.value.reputation += rewardReputation; resources.value.network += rewardNetwork;
                    if (resources.value.cash > 0) resources.value.cash = Math.floor(resources.value.cash * 1.01);
                    const totalChange = playerTotal.value - (snapshot.value.cash + snapshot.value.knowledge + snapshot.value.network + snapshot.value.reputation);
                    // 触发反馈动画（带锁定）
                    if (totalChange > 0) {
                        triggerFlash('win');
                        setTimeout(() => {
                            if (!isAchievementShowing.value) triggerCoinRain(30);
                            else triggerCoinRain(10);
                        }, 300);
                    } else if (totalChange < 0) {
                        triggerFlash('lose');
                        // 亏损时也触发少量金币雨（安慰奖）
                        setTimeout(() => {
                            if (!isAchievementShowing.value) triggerCoinRain(10);
                        }, 300);
                    }
                    // 强制2.6秒后解锁
                    setTimeout(() => {
                        if (isFeedbackShowing.value) {
                            isFeedbackShowing.value = false;
                        }
                    }, 2800);
                    
                    checkAchievements(resources.value);
                    rivalInvest();
                    const change = { cash: resources.value.cash - snapshot.value.cash, knowledge: resources.value.knowledge - snapshot.value.knowledge, network: resources.value.network - snapshot.value.network, reputation: resources.value.reputation - snapshot.value.reputation };
                    roundReport.value = { cardName: card.name, change, totalChange, rivalChange: rival.value.lastChange, rivalTotal: rival.value.total };
                    const reflection = generateReflection(card.id, rewardCash, rewardKnowledge, rewardReputation, rewardNetwork);
                    const result = {
                        cardName: card.name, cost: { cash: costCash, knowledge: costKnowledge, network: costNetwork },
                        reward: { cash: rewardCash, knowledge: rewardKnowledge, reputation: rewardReputation, network: rewardNetwork },
                        event: eventName, lesson: ev ? ev.lesson : null, before: { ...snapshot.value }, after: { ...resources.value },
                        round: round.value + 1, change, rivalTotal: rival.value.total, rivalChange: rival.value.lastChange,
                        reflection: reflection, cardId: card.id
                    };
                    investmentHistory.value.push({ round: round.value + 1, cardName: card.name[lang.value], eventName: eventName ? eventName[lang.value] : null, change: totalChange, reflection: reflection });
                    lastResult.value = result; 
                    // 延迟显示结果弹窗（等反馈动画结束）
                    setTimeout(() => {
                        showResult.value = true;
                    }, 2600);
                    
                    const name = card.name[lang.value];
                    aiFeedback.value = lang.value === 'zh' ? `你投资了${name}。结果：💰${rewardCash} 📚${rewardKnowledge} 🤝${rewardNetwork} ⭐${rewardReputation}` : `You invested in ${name}. Result: 💰${rewardCash} 📚${rewardKnowledge} 🤝${rewardNetwork} ⭐${rewardReputation}`;
                    currentEvent.value = null;
                }

                function confirmResult() {
                    showResult.value = false;
                    round.value++;
                    if (round.value >= maxRounds || resources.value.cash < 0) { gameState.value = 'ending'; generateEnding(); }
                    else { 
                        // 触发下一轮事件（会检查反馈锁定状态）
                        triggerEvent(); 
                        aiFeedback.value = generateAICoachAdvice(); 
                    }
                    selectedCardId.value = null;
                    setTimeout(() => { roundReport.value = null; }, 3000);
                }

                function generateEnding() {
                    const r = resources.value;
                    if (r.cash < 20 || (r.knowledge < 20 && r.network < 20 && r.reputation < 20)) endingType.value = 'bankrupt';
                    else if (r.cash >= 300 && r.reputation >= 60) endingType.value = 'freedom';
                    else if (r.knowledge >= 120 && r.cash >= 100) endingType.value = 'knowledge';
                    else if (r.reputation >= 90 && r.network >= 70) endingType.value = 'business';
                    else if (r.cash >= 150 && r.knowledge >= 50 && r.network >= 50 && r.reputation >= 50) endingType.value = 'balanced';
                    else if (r.knowledge >= 70 && r.network >= 70 && r.reputation >= 70 && r.cash >= 80) endingType.value = 'allround';
                    else endingType.value = 'balanced';
                    triggerAchievement('🏁', endings[endingType.value].title[lang.value], endings[endingType.value].desc[lang.value]);
                    if (playerTotal.value > rival.value.total) showDanmaku('🏆', '哈哈，我赢了！小明你还要努力啊！');
                    else if (playerTotal.value < rival.value.total) showDanmaku('😤', '可恶，输给小明了一点点！下次一定赢！');
                    else showDanmaku('🤝', '平局！我们都很厉害！');
                }

                function resetGame() {
                    resources.value = { ...startResources }; round.value = 0; gameState.value = 'landing'; endingType.value = null;
                    selectedCardId.value = null; eventLog.value = []; usedEventIds.value = []; expandedLogId.value = null; investmentHistory.value = [];
                    tutorialIndex.value = 0;
                    pendingEvent = null;
                    if (eventTriggerTimer) { clearTimeout(eventTriggerTimer); eventTriggerTimer = null; }
                    aiFeedback.value = lang.value === 'zh' ? '💬 你好，我是你的AI财经教练。我不会告诉你该买什么，但我会帮你看到那些你自己没注意到的东西。' : 'Hi, I\'m your AI Coach. I won\'t tell you what to buy, but I\'ll help you see what you\'re missing.';
                    currentEvent.value = null; showEvent.value = false; showResult.value = false; lastResult.value = null; roundReport.value = null;
                    showExitConfirm.value = false; resetRival(); achievement.value = null; isAchievementShowing.value = false;
                    if (achievementTimer) { clearTimeout(achievementTimer); achievementTimer = null; }
                    if (flashTimer) { clearTimeout(flashTimer); flashTimer = null; }
                    if (coinTimer) { clearTimeout(coinTimer); coinTimer = null; }
                    flashClass.value = ''; if (danmakuTimer) { clearTimeout(danmakuTimer); danmakuTimer = null; } danmaku.value = null; coinRain.value = [];
                    isFeedbackShowing.value = false;
                }

                function exitGame() { showExitConfirm.value = true; }
                function confirmExit() { showExitConfirm.value = false; resetGame(); }
                function cancelExit() { showExitConfirm.value = false; }

                function askAI() {
                    if (!aiQuestion.value.trim()) return;
                    const q = aiQuestion.value.toLowerCase();
                    const ev = currentEvent.value;
                    let reply = lang.value === 'zh' ? '🧠 AI教练：' : '🧠 AI Coach: ';
                    
                    if (q.includes('事件') || q.includes('event') || q.includes('传闻') || q.includes('谣言')) {
                        if (ev) {
                            const rumorTexts = ev.rumors ? ev.rumors.map((rum, i) => `${i+1}. ${rum.text}`).join('\n') : '无';
                            reply += `当前事件是「${ev.title.zh}」(${ev.year})。\n📢 市场传闻：\n${rumorTexts}\n\n🤔 你觉得这些传闻中，哪些是真话，哪些是陷阱？`;
                        } else { reply += '当前没有事件。你可以查看事件日志回顾历史事件。'; }
                    } else if (q.includes('小明') || q.includes('对手') || q.includes('rival')) {
                        const mood = getRivalMood();
                        reply += `小明总资产${Math.floor(rival.value.total)}点，${playerTotal.value > rival.value.total ? '你领先' + Math.floor(playerTotal.value - rival.value.total) + '点！' : '他领先你' + Math.floor(rival.value.total - playerTotal.value) + '点'} 他目前情绪：${mood.mood}。\n\n🤔 你觉得他下一步会怎么走？为什么？`;
                    } else if (q.includes('风格') || q.includes('style')) {
                        reply += `小明当前是「${rivalStyles.find(s=>s.id===selectedRivalStyle.value)?.name.zh||''}」风格。\n\n🤔 这个风格下，小明会偏向什么类型的资产？他的弱点在哪里？`;
                    } else if (q.includes('诊断') || q.includes('行为') || q.includes('分析')) {
                        const history = investmentHistory.value;
                        if (history.length >= 2) {
                            const wins = history.filter(h => h.change > 0).length, loses = history.filter(h => h.change < 0).length, totalChange = history.reduce((sum, h) => sum + h.change, 0);
                            let diag = '';
                            if (wins > loses) diag += `👍 胜率${Math.round(wins/history.length*100)}%，但你确定这是实力还是运气？\n`;
                            else if (loses > wins) diag += `📉 亏损偏多（${Math.round(loses/history.length*100)}%），你觉得问题出在哪里？\n`;
                            if (totalChange < 0) diag += `💭 总资产在下降，你需要重新审视自己的投资逻辑。\n`;
                            if (totalChange > 50) diag += `🎉 总资产增长不错，你觉得这种趋势能持续吗？\n`;
                            diag += `\n💡 建议：回顾你每轮选择的理由，找出规律。`;
                            reply += diag;
                        } else { reply += '📊 记录还不够多，再多投几轮我才能帮你分析行为模式。'; }
                    } else if (q.includes('反思') || q.includes('重来')) {
                        if (investmentHistory.value.length > 0) {
                            const last = investmentHistory.value[investmentHistory.value.length - 1];
                            reply += last.reflection;
                        } else {
                            reply += '你还没有投资记录，先试试手吧！';
                        }
                    } else if (q.includes('建议') || q.includes('advice')) {
                        reply += generateAICoachAdvice();
                    } else {
                        reply += '💡 你可以问我：\n- 当前事件是什么？有哪些传闻？\n- 小明现在什么状态？\n- 帮我诊断一下我的投资行为\n- 给我一些反思\n- 你有什么建议？\n\n我不会告诉你买什么，但我会帮你看到那些你忽略的东西。';
                    }
                    aiFeedback.value = reply;
                    aiQuestion.value = '';
                }

                function startGame() {
                    usedEventIds.value = []; investmentHistory.value = []; resources.value = { ...startResources }; resetRival();
                    gameState.value = 'tutorial'; tutorialIndex.value = 0;
                    aiFeedback.value = lang.value === 'zh' ? '💬 欢迎！我是你的AI财经教练。我不会替你做决定，但我会陪你一起思考。' : 'Welcome! I\'m your AI Coach. I\'ll think with you, not for you.';
                }

                function nextTutorial() {
                    if (tutorialIndex.value < tutorialSteps.length - 1) tutorialIndex.value++;
                    else { gameState.value = 'playing'; round.value = 1; triggerEvent(); aiFeedback.value = generateAICoachAdvice(); }
                }
                function skipTutorial() { gameState.value = 'playing'; round.value = 1; triggerEvent(); aiFeedback.value = generateAICoachAdvice(); }

                function generateFinalAssessment() {
                    const totalChange = playerTotal.value - (startResources.cash + startResources.knowledge + startResources.network + startResources.reputation);
                    let riskLevel = 0, saveCount = 0, stockCount = 0, winCount = 0, loseCount = 0;
                    investmentHistory.value.forEach(h => {
                        if (h.change > 0) winCount++;
                        else if (h.change < 0) loseCount++;
                        const card = allCards.find(c => c.name.zh === h.cardName || c.name.en === h.cardName);
                        if (card) { if (card.type === 'save') saveCount++; else if (card.type === 'stock') stockCount++; if (card.risk === 'high') riskLevel++; else if (card.risk === 'medium') riskLevel += 0.5; }
                    });
                    const totalInvestments = investmentHistory.value.length || 1;
                    const winRate = Math.round((winCount / totalInvestments) * 100);
                    const riskScore = Math.round((riskLevel / totalInvestments) * 100);
                    let styleDesc = '';
                    if (riskScore > 60 && stockCount > saveCount) styleDesc = '🔥 激进型投资者，喜欢追逐高收益高风险。';
                    else if (riskScore < 30 && saveCount > stockCount) styleDesc = '🛡️ 保守型投资者，稳扎稳打，注重保本。';
                    else if (winRate > 60) styleDesc = '📈 稳健盈利型，胜率很高，决策质量不错。';
                    else styleDesc = '⚖️ 均衡型投资者，在各类资产中寻找平衡。';
                    let perf = '';
                    if (totalChange > 100) perf = '🎉 总收益超过100点，表现非常出色！';
                    else if (totalChange > 50) perf = '👍 总收益超过50点，表现不错！';
                    else if (totalChange > 0) perf = '😊 略有盈利，方向是对的。';
                    else perf = '🤔 略有亏损，需要复盘某些决策。';
                    return { styleDesc, perf, winRate, winCount, loseCount, riskScore };
                }

                watch(lang, () => {
                    document.getElementById('langLabel').innerText = lang.value === 'zh' ? 'EN / 中' : '中 / EN';
                    const style = rivalStyles.find(s => s.id === selectedRivalStyle.value);
                    if (style) rival.value.style = style.name[lang.value];
                });
                onMounted(() => { document.getElementById('langLabel').innerText = 'EN / 中'; resetRival(); });

                return {
                    lang, toggleLang, gameState, resources, round, maxRounds, allCards, currentCards, currentEvent, showEvent,
                    selectedCardId, aiFeedback, aiQuestion, askAI, tutorialIndex, tutorialSteps, startGame, nextTutorial, skipTutorial,
                    resetGame, selectCard, getCardFit, closeEventManual, isGameOver, currentRound, resourcesArray, endingType,
                    endings, eventLog, generateEnding, triggerEvent, viewEventDetail, showAbout, openAbout, closeAbout,
                    showResult, lastResult, confirmResult, rival, roundReport, danmaku, playerTotal, duelData,
                    flashClass, coinRain, achievement, triggerAchievement, showExitConfirm, exitGame, confirmExit, cancelExit,
                    getTypeLabel, expandedLogId, toggleLogDetail, generateAICoachAdvice, investmentHistory,
                    rivalStyles, selectedRivalStyle, resetRival, generateFinalAssessment, startResources,
                    isAchievementShowing, getRivalMood, isFeedbackShowing
                };
            },
            template: `
            <div>
