                <div class="feedback-lock" :class="{'active': isFeedbackShowing}"></div>
                
                <div class="screen-flash" :class="flashClass"></div>
                <div class="coin-rain" v-if="coinRain.length > 0 && !achievement">
                    <div v-for="(c, idx) in coinRain" :key="idx" class="coin" :style="{ left: c.left, animationDelay: c.delay }">🪙</div>
                </div>
                <div v-if="achievement" class="achievement-popup">
                    <div class="ach-icon">{{ achievement.icon }}</div>
                    <div class="ach-title">{{ achievement.title }}</div>
                    <div class="ach-desc">{{ achievement.desc }}</div>
                </div>

                <div v-if="gameState === 'playing'" class="duel-progress">
                    <div class="duel-labels">
                        <span class="you-label">🟢 你 {{ Math.floor(playerTotal) }}</span>
                        <span class="rival-label">🔴 小明 {{ Math.floor(rival.total) }} <span style="font-size:0.6rem;opacity:0.5;">{{ getRivalMood().emoji }} {{ getRivalMood().mood }}</span></span>
                    </div>
                    <div class="duel-track">
                        <div class="bar-container">
                            <div class="you-bar" :style="{ width: duelData.you + '%' }">{{ Math.floor(duelData.you) > 20 ? Math.floor(playerTotal) : '' }}</div>
                            <div class="rival-bar" :style="{ width: duelData.rival + '%' }">{{ Math.floor(duelData.rival) > 20 ? Math.floor(rival.total) : '' }}</div>
                            <div class="vs-marker">VS</div>
                        </div>
                    </div>
                </div>

                <div v-if="danmaku && gameState === 'playing'" class="rival-danmaku"><span class="danmaku-icon">{{ danmaku.icon }}</span><span class="danmaku-text"><span class="highlight">小明</span>：{{ danmaku.text }}</span></div>

                <div v-if="gameState === 'playing'" class="rival-panel">
                    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                        <span class="rival-name"><i class="fas fa-user-circle"></i> 小明 <span class="rival-tag">对手</span></span>
                        <span style="opacity:0.5;font-size:0.8rem;">总资产</span>
                        <span class="rival-assets">{{ Math.floor(rival.total) }}</span>
                        <span class="rival-change" :class="rival.lastChange >= 0 ? 'up' : 'down'">{{ rival.lastChange >= 0 ? '▲' : '▼' }} {{ Math.abs(Math.floor(rival.lastChange)) }}</span>
                        <span class="rival-style">{{ rival.style }}</span>
                        <span class="rival-mood">{{ getRivalMood().emoji }} {{ getRivalMood().mood }}</span>
                    </div>
                    <div class="rival-detail"><span>💰{{ Math.floor(rival.cash) }}</span><span>📚{{ Math.floor(rival.knowledge) }}</span><span>🤝{{ Math.floor(rival.network) }}</span><span>⭐{{ Math.floor(rival.reputation) }}</span></div>
                </div>

