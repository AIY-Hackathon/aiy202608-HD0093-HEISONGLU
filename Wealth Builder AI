        .btn-danger { background: linear-gradient(145deg, #8f2a2a, #5a1a1a); border-color: #c27a7a; color: #f0d5d5; }
        .btn-danger:hover { transform: scale(1.03); box-shadow: 0 0 30px rgba(194, 122, 122, 0.3); }
        .btn-sm { padding: 6px 14px; font-size: 0.8rem; }
        .btn:hover { opacity: 0.9; transform: translateY(-2px); }
        /* 反馈锁定遮罩 */
        .feedback-lock { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 250; pointer-events: none; }
        .feedback-lock.active { pointer-events: auto; background: rgba(0,0,0,0.15); }
        .lang-toggle { position: fixed; bottom: 20px; left: 20px; z-index: 999; background: rgba(30, 35, 40, 0.75); backdrop-filter: blur(10px); border: 1px solid rgba(184, 148, 60, 0.3); border-radius: 40px; padding: 6px 14px; color: #e8d5a3; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 0.75rem; transition: all 0.3s; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .lang-toggle:hover { background: rgba(30, 35, 40, 0.95); border-color: #b8943c; }
        .resources-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
        .resource-item { background: rgba(10, 14, 18, 0.7); border-radius: 60px; padding: 10px 16px; display: flex; align-items: center; gap: 12px; border: 1px solid #2a2f36; backdrop-filter: blur(2px); transition: all 0.3s; position: relative; overflow: hidden; }
        .resource-icon { font-size: 1.6rem; width: 40px; text-align: center; }
        .resource-info { flex: 1; }
        .resource-label { font-size: 0.7rem; opacity: 0.6; letter-spacing: 0.5px; }
        .resource-value { font-size: 1.5rem; font-weight: 700; line-height: 1.2; color: #f0e2c0; transition: all 0.3s; }
        .resource-value.flash-green { color: #6fcf97; text-shadow: 0 0 20px rgba(111, 207, 151, 0.6); }
        .resource-value.flash-red { color: #f28b82; text-shadow: 0 0 20px rgba(242, 139, 130, 0.6); }
        .progress-bar { height: 4px; background: #2a2f36; border-radius: 10px; margin-top: 2px; }
        .progress-fill { height: 4px; border-radius: 10px; background: linear-gradient(90deg, #b8943c, #e6c27a); transition: width 0.4s; }
        .round-badge { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
        .round-text { font-size: 1.3rem; font-weight: 300; color: #b8943c; letter-spacing: 1px; }
        .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin: 16px 0; }
        .investment-card { background: #171c21; border-radius: 28px; padding: 16px 14px 20px; border: 1px solid #2f353d; transition: 0.2s; cursor: pointer; box-shadow: 0 6px 0 #0b0d10; }
        .investment-card:hover { transform: translateY(-4px); border-color: #b8943c; box-shadow: 0 12px 24px rgba(0,0,0,0.6); }
        .card-title { font-size: 1.0rem; font-weight: 600; color: #e6d5b0; }
        .card-sub { font-size: 0.7rem; opacity: 0.5; margin-bottom: 6px; }
        .card-cost { display: flex; flex-wrap: wrap; gap: 6px 10px; background: #0f1318; padding: 6px 10px; border-radius: 30px; margin: 6px 0; font-size: 0.8rem; }
        .badge-risk { background: #2d1f1a; color: #e69b7a; padding: 2px 10px; border-radius: 30px; font-size: 0.65rem; }
        .badge-reward { background: #1f2a1f; color: #8fc98a; padding: 2px 10px; border-radius: 30px; font-size: 0.65rem; }
        .badge-save { background: #1a2a3a; color: #7ab8e6; padding: 2px 10px; border-radius: 30px; font-size: 0.65rem; }
        .badge-education { background: #2a2a3a; color: #b87ae6; padding: 2px 10px; border-radius: 30px; font-size: 0.65rem; }
        .badge-fun { background: #3a2a1a; color: #e6b87a; padding: 2px 10px; border-radius: 30px; font-size: 0.65rem; }
        .card-fit { margin-top: 6px; font-size: 0.7rem; color: #b8943c; border-top: 1px solid #2a2f36; padding-top: 6px; }
