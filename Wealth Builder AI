        .event-modal .rumors-section { background: #0f1318; border-radius: 16px; padding: 14px 16px; margin: 12px 0; border-left: 3px solid #b87ae6; }
        .event-modal .rumors-section .rumor-label { color: #b87ae6; font-weight: 600; font-size: 0.75rem; letter-spacing: 1px; margin-bottom: 6px; display: block; }
        .event-modal .rumors-section .rumor-item { font-size: 0.9rem; opacity: 0.9; padding: 4px 0; line-height: 1.5; display: flex; align-items: center; gap: 8px; }
        .event-modal .rumors-section .rumor-item .rumor-marker { opacity: 0.4; font-size: 0.8rem; }
        .event-modal .rumors-section .rumor-item .rumor-tag { font-size: 0.75rem; font-weight: 700; padding: 2px 12px; border-radius: 20px; letter-spacing: 0.5px; flex-shrink: 0; background: #2a2a2a; color: #e6b87a; border: 1px solid #b87ae6; }
        .event-modal .lesson-box { background: #1c2329; padding: 12px 16px; border-radius: 16px; margin: 12px 0 18px; font-size: 0.9rem; border: 1px dashed #b8943c; }
        .event-modal .lesson-box i { color: #b8943c; margin-right: 8px; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        .ai-coach-area { background: #11161b; border-radius: 40px; padding: 18px 22px; margin: 24px 0; border-left: 6px solid #b8943c; }
        .ai-header { display: flex; align-items: center; gap: 14px; font-weight: 600; color: #e6d5b0; }
        .ai-bubble { background: #1c2329; padding: 14px 18px; border-radius: 28px; margin: 10px 0; border: 1px solid #2f353d; line-height: 1.8; font-size: 0.95rem; min-height: 60px; white-space: pre-line; max-height: 300px; overflow-y: auto; }
        .ai-bubble::-webkit-scrollbar { width: 4px; }
        .ai-bubble::-webkit-scrollbar-track { background: #0f1318; border-radius: 10px; }
        .ai-bubble::-webkit-scrollbar-thumb { background: #b8943c; border-radius: 10px; }
        .ai-question-input { display: flex; gap: 10px; margin-top: 10px; }
        .ai-question-input input { flex: 1; background: #0f1318; border: 1px solid #3a3f47; border-radius: 60px; padding: 10px 16px; color: #e8e6e3; }
        .ending-container { text-align: center; padding: 30px 20px; max-height: 90vh; overflow-y: auto; }
        .ending-container::-webkit-scrollbar { width: 6px; }
        .ending-container::-webkit-scrollbar-track { background: #0f1318; border-radius: 10px; }
        .ending-container::-webkit-scrollbar-thumb { background: #b8943c; border-radius: 10px; }
        .ending-icon { font-size: 4.5rem; margin: 12px 0; }
        .flex-row { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; }
        .event-log { max-height: 200px; overflow-y: auto; background: #0f1318; border-radius: 24px; padding: 12px 16px; margin: 12px 0; border: 1px solid #2a2f36; }
        .log-item { padding: 6px 0; border-bottom: 1px solid #1e2328; font-size: 0.85rem; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .log-item:hover { background: #1a1f24; border-radius: 8px; padding-left: 8px; }
        .log-item .log-year { color: #b8943c; font-weight: 600; }
        .log-item .log-event-name { flex: 1; }
        .log-item .log-view-btn { color: #7ab8e6; font-size: 0.7rem; opacity: 0.6; }
        .log-item .log-view-btn:hover { opacity: 1; }
        .log-detail { background: #0a0d10; border-radius: 16px; padding: 12px 16px; margin-top: 6px; border-left: 3px solid #b8943c; font-size: 0.85rem; line-height: 1.6; display: none; }
        .log-detail.open { display: block; }
        .log-detail .rumor-tag { font-size: 0.65rem; font-weight: 700; padding: 1px 10px; border-radius: 20px; background: #2a2a2a; color: #e6b87a; border: 1px solid #b87ae6; margin-left: 4px; }
        .about-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); display: flex; justify-content: center; align-items: center; z-index: 2000; animation: fadeIn 0.3s; }
        .about-modal { max-width: 720px; width: 92%; max-height: 85vh; overflow-y: auto; background: #1a1f24; border: 1px solid #b8943c; border-radius: 48px; padding: 40px 36px; box-shadow: 0 40px 80px rgba(0,0,0,0.9); }
        .about-modal::-webkit-scrollbar { width: 6px; }
        .about-modal::-webkit-scrollbar-track { background: #0f1318; border-radius: 10px; }
        .about-modal::-webkit-scrollbar-thumb { background: #b8943c; border-radius: 10px; }
        .about-modal h1 { font-size: 2.2rem; color: #e6c27a; margin-bottom: 6px; }
        .about-modal .subhead { color: #b8943c; font-size: 1.1rem; font-weight: 300; margin-bottom: 24px; border-bottom: 1px solid #2a2f36; padding-bottom: 16px; }
        .about-modal h3 { color: #e6d5b0; margin: 20px 0 8px; font-size: 1.1rem; }
        .about-modal p { opacity: 0.8; line-height: 1.7; margin-bottom: 12px; font-size: 0.95rem; }
        .about-modal ul { padding-left: 20px; opacity: 0.8; line-height: 1.8; }
        .about-modal .close-about { margin-top: 28px; display: flex; justify-content: flex-end; }
        .result-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); display: flex; justify-content: center; align-items: center; z-index: 1500; animation: fadeIn 0.3s; }
        .result-modal { max-width: 650px; width: 94%; background: #1a1f24; border: 1px solid #b8943c; border-radius: 48px; padding: 32px 30px; box-shadow: 0 40px 80px rgba(0,0,0,0.9); max-height: 90vh; overflow-y: auto; }
        .result-modal .result-title { font-size: 1.6rem; color: #e6c27a; margin-bottom: 4px; }
        .result-modal .result-sub { opacity: 0.6; font-size: 0.9rem; margin-bottom: 16px; }
        .result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; background: #0f1318; border-radius: 28px; padding: 16px 18px; margin: 12px 0; }
        .result-item { display: flex; align-items: center; gap: 10px; font-size: 0.95rem; }
        .result-item .change { font-weight: 700; margin-left: auto; }
        .change.positive { color: #6fcf97; }
        .change.negative { color: #f28b82; }
        .result-event-badge { background: #1c2329; border-radius: 20px; padding: 10px 14px; margin: 10px 0; border-left: 4px solid #b8943c; font-size: 0.9rem; }
        .result-modal .btn { width: 100%; justify-content: center; margin-top: 10px; }
        .reflection-box { background: #1c2329; border-radius: 20px; padding: 16px 18px; margin: 12px 0; border-left: 4px solid #b87ae6; }
        .reflection-box .reflection-title { color: #b87ae6; font-weight: 600; font-size: 0.9rem; }
        .reflection-box .reflection-content { opacity: 0.85; line-height: 1.6; margin-top: 4px; font-size: 0.9rem; }
        /* 反馈动画 - 2.5秒 */
        .screen-flash { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 300; opacity: 0; transition: opacity 0.1s; }
        .screen-flash.flash-green { background: radial-gradient(circle at center, rgba(111, 207, 151, 0.5) 0%, transparent 70%); opacity: 1; animation: flashFade 2.5s ease forwards; }
        .screen-flash.flash-red { background: radial-gradient(circle at center, rgba(242, 139, 130, 0.6) 0%, transparent 70%); opacity: 1; animation: flashFade 2.5s ease forwards; }
        @keyframes flashFade { 0% { opacity: 0; } 10% { opacity: 1; } 60% { opacity: 0.9; } 100% { opacity: 0; } }
        .coin-rain { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 200; overflow: hidden; opacity: 0.8; }
        .coin { position: absolute; font-size: 2rem; animation: coinFall 2.5s ease-out forwards; opacity: 0; }
        @keyframes coinFall { 0% { transform: translateY(-20px) rotate(0deg) scale(0.5); opacity: 1; } 100% { transform: translateY(calc(100vh + 50px)) rotate(720deg) scale(1.2); opacity: 0; } }
        .achievement-popup { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); background: linear-gradient(145deg, #1a1f24, #2a2f36); border: 2px solid #e6c27a; border-radius: 40px; padding: 30px 40px; z-index: 500; box-shadow: 0 0 80px rgba(184, 148, 60, 0.4); text-align: center; animation: achievementPop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; pointer-events: none; }
        .achievement-popup .ach-icon { font-size: 4rem; margin-bottom: 8px; }
        .achievement-popup .ach-title { font-size: 1.8rem; color: #e6c27a; font-weight: 700; }
        .achievement-popup .ach-desc { opacity: 0.8; font-size: 1rem; margin-top: 4px; }
        @keyframes achievementPop { 0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; } 60% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
        .rival-panel { background: linear-gradient(145deg, #1a1f2a, #0f1318); border-radius: 24px; padding: 14px 20px; margin-bottom: 16px; border: 2px solid #e6c27a; box-shadow: 0 0 30px rgba(184, 148, 60, 0.15); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; position: relative; z-index: 10; }
