        .rival-panel .rival-style { font-size: 0.7rem; opacity: 0.5; padding: 2px 10px; border-radius: 20px; background: #1a1f24; }
        .rival-panel .rival-mood { font-size: 0.7rem; padding: 2px 10px; border-radius: 20px; background: #1a2a1a; color: #6fcf97; }
        .player-tag { background: #2a3a2a; color: #6fcf97; padding: 2px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; border: 1px solid #6fcf97; }
        .rival-tag { background: #3a2a2a; color: #f28b82; padding: 2px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; border: 1px solid #f28b82; }
        .duel-progress { background: #0f1318; border-radius: 30px; padding: 10px 16px; margin-bottom: 16px; border: 1px solid #2a2f36; position: relative; z-index: 10; }
        .duel-progress .duel-labels { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px; }
        .duel-progress .duel-labels .you-label { color: #6fcf97; font-weight: 600; }
        .duel-progress .duel-labels .rival-label { color: #f28b82; font-weight: 600; }
        .duel-track { position: relative; height: 28px; background: #1a1f24; border-radius: 30px; overflow: visible; box-shadow: inset 0 2px 6px rgba(0,0,0,0.5); display: flex; align-items: center; }
