        .card-type-tag.save { background: #1a2a3a; color: #7ab8e6; }
        .card-type-tag.edu { background: #2a2a3a; color: #b87ae6; }
        .card-type-tag.fun { background: #3a2a1a; color: #e6b87a; }
        .event-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); display: flex; justify-content: center; align-items: center; z-index: 1000; animation: fadeIn 0.3s; }
        .event-modal { max-width: 580px; width: 94%; background: #1a1f24; border: 1px solid #b8943c; border-radius: 48px; padding: 36px 32px; box-shadow: 0 40px 80px rgba(0,0,0,0.9); max-height: 90vh; overflow-y: auto; }
