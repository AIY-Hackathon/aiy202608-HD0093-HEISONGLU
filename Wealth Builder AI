                    </div>
                </div>

                <div v-if="showAbout" class="about-overlay" @click.self="closeAbout"><div class="about-modal"><h1>🏦 Wealth Builder AI</h1><div class="subhead">财富成长实验室 · 金融教育模拟游戏</div><h3>🎯 核心理念</h3><p>真正的投资没有标准答案。每轮事件只会描述现象，你需要自己判断什么资产会受益。AI教练会问问题引导思考，但不会替你决策。</p><h3>🧠 小明风格</h3><p>你可以选择小明的投资风格：激进型、保守型、跟风型、反转型、随机型。小明会有情绪变化，也可能被市场谣言误导。</p><h3>📊 学习目标</h3><ul><li>✔ 理解宏观经济事件背后的逻辑</li><li>✔ 培养独立判断能力，不盲从</li><li>✔ 学会反思自己的决策</li><li>✔ 辨别真假财经资讯</li></ul><div class="close-about"><button class="btn btn-primary" @click="closeAbout"><i class="fas fa-check"></i> 开始探索</button></div></div></div>

                <div v-if="gameState === 'tutorial'" class="card">
                    <div class="tutorial-step">
                        <h2>{{ tutorialSteps[tutorialIndex].title[lang] }}</h2>
                        <p style="margin:14px 0;">{{ tutorialSteps[tutorialIndex].desc[lang] }}</p>
                        <div style="display:flex;gap:12px;flex-wrap:wrap;">
                            <button class="btn btn-primary" @click="nextTutorial">{{ tutorialIndex === tutorialSteps.length-1 ? (lang==='zh'?'开始游戏':'Start') : (lang==='zh'?'下一步':'Next') }}</button>
                            <button class="btn" @click="skipTutorial">{{ lang==='zh'?'跳过教程':'Skip' }}</button>
                        </div>
                    </div>
                </div>

                <div v-if="gameState === 'playing'">
                    <div class="event-log" v-if="eventLog.length">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;opacity:0.5;font-size:0.8rem;">
                            <span>📋 历史事件（点击查看详情）</span>
                            <span>{{ eventLog.length }} 个事件</span>
                        </div>
                        <div v-for="(log, idx) in eventLog" :key="idx">
                            <div class="log-item" @click="toggleLogDetail(idx)">
                                <span class="log-year">[{{ log.event.year }}]</span>
                                <span class="log-event-name">{{ log.event.title[lang] }}</span>
                                <span class="log-view-btn"><i class="fas fa-chevron-down" :class="{'fa-rotate-180': expandedLogId === idx}"></i></span>
                            </div>
                            <div class="log-detail" :class="{'open': expandedLogId === idx}">
                                <div style="color:#b87ae6;font-weight:600;">📢 市场传闻</div>
                                <div v-for="(rum, ri) in log.event.rumors" :key="ri" style="opacity:0.8;font-size:0.85rem;padding:2px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                    <span>{{ ri+1 }}.</span>
                                    <span>{{ rum.text }}</span>
                                    <span class="rumor-tag">❓ 存疑</span>
                                </div>
                                <div style="margin-top:6px;color:#6fcf97;">💡 {{ log.event.lesson[lang] }}</div>
                                <button class="btn btn-sm btn-primary" @click.stop="viewEventDetail(log)" style="margin-top:8px;"><i class="fas fa-eye"></i> 查看完整事件</button>
                            </div>
                        </div>
                    </div>
                    <div v-else style="text-align:center;padding:12px;opacity:0.4;font-size:0.9rem;">暂无事件记录</div>

                    <div v-if="currentEvent && showEvent === false" style="background:#1c2329;border-radius:16px;padding:8px 16px;margin:8px 0;border-left:4px solid #b8943c;font-size:0.85rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
                        <span>📌 当前事件：<strong>{{ currentEvent.title[lang] }}</strong> ({{ currentEvent.year }})</span>
                        <span style="font-size:0.7rem;opacity:0.5;">💡 市场传闻 {{ currentEvent.rumors ? currentEvent.rumors.length : 0 }} 条</span>
                    </div>

                    <div class="card-grid">
                        <div v-for="card in allCards" :key="card.id" class="investment-card" @click="selectCard(card.id)">
                            <div><span class="card-type-tag" :class="card.type">{{ getTypeLabel(card.type)[lang] }}</span></div>
                            <div class="card-title">{{ card.name[lang] }}</div>
                            <div class="card-sub">{{ card.concept[lang] }}</div>
                            <div class="card-cost">
                                <span v-if="card.cost.cash"><i class="fas fa-coins"></i> -{{ card.cost.cash }}</span>
                                <span v-if="card.cost.knowledge"><i class="fas fa-book"></i> -{{ card.cost.knowledge }}</span>
                                <span v-if="card.cost.network"><i class="fas fa-users"></i> -{{ card.cost.network }}</span>
                            </div>
                            <div>
                                <span class="badge-risk" v-if="card.risk">风险: {{ card.risk==='high'?'高':card.risk==='medium'?'中':'低' }}</span>
                                <span class="badge-reward" v-if="card.reward.cash"><i class="fas fa-arrow-up"></i> {{ card.reward.cash || 0 }}💰</span>
                                <span class="badge-save" v-if="card.type === 'save'">🛡️ 保本</span>
                                <span class="badge-education" v-if="card.type === 'edu'">📚 知识</span>
                            </div>
                            <div class="card-fit">{{ getCardFit(card) }}</div>
                        </div>
                    </div>

                    <div class="ai-coach-area">
                        <div class="ai-header"><i class="fas fa-robot" style="color:#b8943c;"></i> AI Financial Coach</div>
                        <div class="ai-bubble" style="border-left:4px solid #b87ae6;white-space:pre-line;">{{ aiFeedback }}</div>
                        <div class="ai-question-input">
                            <input v-model="aiQuestion" :placeholder="lang==='zh'?'向AI提问（如：当前事件是什么？有什么传闻？帮我诊断）':'Ask AI (e.g., What is the event? Any rumors? Diagnose me)'" @keyup.enter="askAI">
                            <button class="btn" @click="askAI"><i class="fas fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>

                <div v-if="showResult && lastResult" class="result-overlay" @click.self="confirmResult">
                    <div class="result-modal">
                        <div class="result-title">📊 投资结果</div>
                        <div class="result-sub">第 {{ lastResult.round }} 轮 · {{ lastResult.cardName[lang] }}</div>
                        <div class="result-event-badge" v-if="lastResult.event"><div style="font-weight:600;color:#e6c27a;">{{ lastResult.event[lang] }}</div><div style="font-size:0.8rem;opacity:0.7;" v-if="lastResult.lesson">{{ lastResult.lesson[lang] }}</div></div>
                        <div class="result-grid">
                            <div class="result-item"><span>💰 现金</span><span class="change" :class="lastResult.change.cash >= 0 ? 'positive' : 'negative'">{{ lastResult.change.cash >= 0 ? '+' : '' }}{{ Math.floor(lastResult.change.cash) }}</span><span style="opacity:0.5;font-size:0.8rem;">→ {{ Math.floor(lastResult.after.cash) }}</span></div>
                            <div class="result-item"><span>📚 知识</span><span class="change" :class="lastResult.change.knowledge >= 0 ? 'positive' : 'negative'">{{ lastResult.change.knowledge >= 0 ? '+' : '' }}{{ Math.floor(lastResult.change.knowledge) }}</span><span style="opacity:0.5;font-size:0.8rem;">→ {{ Math.floor(lastResult.after.knowledge) }}</span></div>
                            <div class="result-item"><span>🤝 人脉</span><span class="change" :class="lastResult.change.network >= 0 ? 'positive' : 'negative'">{{ lastResult.change.network >= 0 ? '+' : '' }}{{ Math.floor(lastResult.change.network) }}</span><span style="opacity:0.5;font-size:0.8rem;">→ {{ Math.floor(lastResult.after.network) }}</span></div>
                            <div class="result-item"><span>⭐ 声誉</span><span class="change" :class="lastResult.change.reputation >= 0 ? 'positive' : 'negative'">{{ lastResult.change.reputation >= 0 ? '+' : '' }}{{ Math.floor(lastResult.change.reputation) }}</span><span style="opacity:0.5;font-size:0.8rem;">→ {{ Math.floor(lastResult.after.reputation) }}</span></div>
                        </div>
                        <div class="reflection-box" v-if="lastResult.reflection"><div class="reflection-title">🤔 如果重来一次</div><div class="reflection-content">{{ lastResult.reflection }}</div></div>
                        <div style="display:flex;justify-content:space-between;margin:8px 0 12px;padding:8px 12px;background:#0f1318;border-radius:20px;font-size:0.9rem;"><span>🤼 小明 总资产: {{ Math.floor(lastResult.rivalTotal) }}</span><span :style="{color: lastResult.rivalChange >= 0 ? '#6fcf97' : '#f28b82'}">{{ lastResult.rivalChange >= 0 ? '+' : '' }}{{ Math.floor(lastResult.rivalChange) }}</span></div>
                        <button class="btn btn-primary" @click="confirmResult">继续下一轮 →</button>
                    </div>
                </div>

                <!-- 事件弹窗 -->
                <div v-if="showEvent && currentEvent" class="event-overlay" @click.self="closeEventManual">
                    <div class="event-modal">
                        <div class="event-year">📅 {{ currentEvent.year }}</div>
                        <div class="event-title">{{ currentEvent.title[lang] }}</div>
                        <div class="rumors-section" v-if="currentEvent.rumors && currentEvent.rumors.length > 0">
                            <span class="rumor-label">📢 市场传闻</span>
                            <div v-for="(rum, idx) in currentEvent.rumors" :key="idx" class="rumor-item">
                                <span class="rumor-marker">{{ idx+1 }}.</span>
                                <span class="rumor-text">{{ rum.text }}</span>
                                <span class="rumor-tag">❓ 存疑</span>
                            </div>
                            <div style="margin-top:8px;padding-top:8px;border-top:1px solid #2a2f36;font-size:0.75rem;opacity:0.4;">🤔 这些传闻中，哪些可能影响你的投资决策？</div>
                        </div>
                        <div class="lesson-box" v-if="currentEvent.lesson"><i class="fas fa-graduation-cap"></i><strong>{{ lang === 'zh' ? '知识点：' : 'Key Lesson: ' }}</strong>{{ currentEvent.lesson[lang] }}</div>
                        <button class="btn btn-primary" @click="closeEventManual" style="width:100%;justify-content:center;">{{ lang === 'zh' ? '我看到了，开始决策' : 'I see, let me decide' }}</button>
                    </div>
                </div>

                <div v-if="showExitConfirm" class="exit-overlay" @click.self="cancelExit"><div class="exit-modal"><h2>🚪 确定要退出吗？</h2><p>退出后当前进度将丢失，确定要离开吗？</p><div class="exit-btns"><button class="btn btn-danger" @click="confirmExit"><i class="fas fa-check"></i> 确定退出</button><button class="btn btn-primary" @click="cancelExit"><i class="fas fa-arrow-left"></i> 继续游戏</button></div></div></div>

                <div v-if="gameState === 'ending'" class="card ending-container">
                    <div class="ending-icon">{{ endings[endingType]?.icon || '🏁' }}</div>
                    <h1 style="color:#e6c27a;">{{ endings[endingType]?.title[lang] || '结局' }}</h1>
                    <p style="max-width:500px;margin:12px auto;opacity:0.8;">{{ endings[endingType]?.desc[lang] || '' }}</p>
                    <div style="background:#0f1318;border-radius:20px;padding:16px;margin:12px 0;">
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
                            <div v-for="res in resourcesArray" :key="res.key" style="text-align:center;">
                                <div style="font-size:1.8rem;">{{ res.icon }}</div>
                                <div style="font-size:1.4rem;font-weight:700;color:#f0e2c0;">{{ Math.floor(res.value) }}</div>
                                <div style="font-size:0.7rem;opacity:0.5;">{{ res.label[lang] }}</div>
                                <div style="font-size:0.75rem;font-weight:600;" :class="res.value - startResources[res.key] >= 0 ? 'positive' : 'negative'">{{ res.value - startResources[res.key] >= 0 ? '+' : '' }}{{ Math.floor(res.value - startResources[res.key]) }}</div>
                            </div>
                        </div>
                        <div style="text-align:center;margin-top:10px;color:#b8943c;font-size:0.9rem;">总资产：<span style="font-size:1.4rem;font-weight:700;color:#e6c27a;">{{ Math.floor(playerTotal) }}</span><span style="opacity:0.5;">（初始 {{ Math.floor(startResources.cash + startResources.knowledge + startResources.network + startResources.reputation) }}）</span><span style="font-weight:600;" :class="playerTotal - (startResources.cash + startResources.knowledge + startResources.network + startResources.reputation) >= 0 ? 'positive' : 'negative'">{{ playerTotal - (startResources.cash + startResources.knowledge + startResources.network + startResources.reputation) >= 0 ? '+' : '' }}{{ Math.floor(playerTotal - (startResources.cash + startResources.knowledge + startResources.network + startResources.reputation)) }}</span></div>
                    </div>
                    <div class="final-assessment" v-if="investmentHistory.length > 0">
                        <div class="assessment-title"><span>📊</span><span>投资风格分析</span></div>
                        <div class="assessment-content"><p>{{ generateFinalAssessment().styleDesc }}</p><p>{{ generateFinalAssessment().perf }}</p><p style="margin-top:6px;font-size:0.85rem;opacity:0.6;">📊 赢 {{ generateFinalAssessment().winCount }} 轮 / 输 {{ generateFinalAssessment().loseCount }} 轮 · 胜率 {{ generateFinalAssessment().winRate }}% · 风险偏好 {{ generateFinalAssessment().riskScore }}%</p></div>
                    </div>
                    <div class="ending-review">
                        <h3 style="color:#b8943c;margin:16px 0 12px;">📋 10轮决策回顾</h3>
                        <div v-for="(h, idx) in investmentHistory" :key="idx" class="review-round">
                            <div class="round-header">
                                <span>第 {{ h.round }} 轮</span>
                                <span class="round-result" :class="h.change >= 0 ? 'win' : 'lose'">{{ h.change >= 0 ? '+' : '' }}{{ Math.floor(h.change) }}</span>
                            </div>
                            <div class="round-detail">
                                <span style="color:#e6d5b0;">{{ h.cardName }}</span>
                                <span v-if="h.eventName" style="opacity:0.5;margin-left:8px;">| {{ h.eventName }}</span>
                            </div>
                            <div style="font-size:0.8rem;opacity:0.6;margin-top:4px;">{{ h.reflection }}</div>
                        </div>
                    </div>
                    <div style="opacity:0.5;font-size:0.9rem;margin-bottom:16px;">🤼 小明 最终总资产: {{ Math.floor(rival.total) }} | 风格: {{ rival.style }}</div>
                    <div v-if="danmaku" style="background:#1c2329;border-radius:20px;padding:10px 16px;margin-bottom:16px;border-left:4px solid #f28b82;"><span style="opacity:0.7;font-size:0.8rem;">小明最后说：</span><span>{{ danmaku.text }}</span></div>
                    <button class="btn btn-primary" @click="resetGame"><i class="fas fa-redo"></i> 重新开始</button>
                    <button class="btn" @click="alert('成绩卡片已复制（模拟）')"><i class="fas fa-share-alt"></i> 分享成绩</button>
                </div>
            </div>
            `
        });
        app.mount('#app');
    </script>
</body>
</html>
